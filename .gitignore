# Secrets. Both env files hold live credentials (ClickHouse, Langfuse, LibreChat secrets) and
# sync to the EC2 host via rsync/FileZilla, never via git.
.env
librechat/.env

# TLS key material.
deploy/ssl/
ssl_star_dot_io/

# LibreChat runtime state (mongo data, uploads, logs).
librechat/data-node/
librechat/uploads/
librechat/logs/
librechat/meili_data*/

# Build output and dependencies.
node_modules/
frontend/.next/
frontend/node_modules/

# Runtime artifacts.
evidence/
.live_producer.*
.derive_watermark.*
.idea/
