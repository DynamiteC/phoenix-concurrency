# Copy to .env and fill in from the ClickHouse Cloud console. .env is gitignored, which means it
# is NOT in the submission archive either: create it on the host before the first `compose up`.
CH_HOST=xxxx.region.clickhouse.cloud

# THE NATIVE PORT, NOT THE HTTPS ONE. scripts/ch.sh passes this to `clickhouse client`, which
# speaks the native protocol on 9440. Setting it to 8443 (the HTTPS interface) fails every
# script with `Code: 102 ... UNEXPECTED_PACKET_FROM_SERVER (expected Hello, got 72)`, where 72
# is the 'H' of "HTTP/1.1", WHILE THE WEB CONSOLE STAYS GREEN: frontend/src/lib/env.ts reads
# CH_HTTP_PORT and defaults to 8443 on purpose, so it never reads this value. A healthy web
# container is therefore no evidence that this line is right.
CH_PORT=9440

CH_USER=default
CH_PASSWORD=

# DATASET ROUTING. These four must not collapse onto one name. CH_DATABASE is v1's frozen
# "Original corpus"; LIVE_DB is what the producer and ticker write to. Pointing both at the same
# database silently mixes generated events into the graded answers, because the serving queries
# no longer carry a frozen-timestamp predicate: the boundary is the database name now, see
# frontend/src/lib/env.ts. Build the frozen copy from a live database with:
#
#   FROZEN_BEFORE=2026-08-01 CUT_BEFORE='2026-07-31 23:59:59.999' \
#     SRC_DB=<live> DST_DB=<frozen> ./scripts/replicate.sh
CH_DATABASE=phoenix_graded
CH_UNSEEN_DATABASE=phoenix_unseen
CH_INSIGHT_DATABASE=phoenix_live
LIVE_DB=phoenix_live

# Blank until LibreChat is up and a key plus a Project Assistant agent id exist in its UI. The v2
# Ask tab fails loudly per request until both are set; every other view works without them.
LIBRECHAT_API_KEY=
LIBRECHAT_AGENT_ID=
