# Copy to .env and fill in from the ClickHouse Cloud console. .env is gitignored.
# Never commit a filled-in copy of this file.

# ClickHouse Cloud connection. Credentials are per-team, each team loads into its own service.
CH_HOST=xxxx.region.clickhouse.cloud
CH_PORT=9440
CH_HTTP_PORT=8443
CH_USER=default
CH_PASSWORD=
CH_DATABASE=phoenix_graded
CH_INSIGHT_DATABASE=phoenix_live
CH_UNSEEN_DATABASE=phoenix_unseen

# Live demo loop: which database the producer and ticker write into, and the tick period in
# seconds for the incremental derive.
LIVE_DB=phoenix_live
DERIVE_PERIOD=60

# LibreChat integration for the v2 Ask tab. LIBRECHAT_URL is server-to-server on the compose
# network (http://api:3080), not reached from the browser directly.
LIBRECHAT_URL=http://api:3080
LIBRECHAT_API_KEY=
LIBRECHAT_AGENT_ID=

# Set to true only for local/demo use if the server is allowed to fall back to a server-side LLM
# key when a request has none. Leave unset or false in any environment that is not fully trusted.
ALLOW_SERVER_LLM_KEY=false
